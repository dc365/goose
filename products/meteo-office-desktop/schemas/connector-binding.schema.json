{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meteomate.local/schemas/connector-binding.schema.json",
  "title": "MeteoMate Connector Binding",
  "type": "object",
  "required": ["apiVersion", "kind", "id", "name", "transport", "enabled", "projectIds"],
  "properties": {
    "apiVersion": { "const": "meteomate.ai/v1" },
    "kind": { "const": "ConnectorBinding" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "version": { "type": "string" },
    "transport": { "enum": ["stdio", "streamable-http"] },
    "command": { "type": "string" },
    "args": { "type": "array", "items": { "type": "string" } },
    "cwd": { "type": ["string", "null"] },
    "url": { "type": "string" },
    "timeout": { "type": "number", "minimum": 3, "maximum": 600 },
    "enabled": { "type": "boolean" },
    "projectIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "secretStorage": { "type": "object" },
    "lastTest": { "type": ["object", "null"] }
  }
}
