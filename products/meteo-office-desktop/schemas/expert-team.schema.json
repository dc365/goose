{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meteomate.local/schemas/expert-team.schema.json",
  "title": "MeteoMate Expert Team",
  "type": "object",
  "required": ["id", "kind", "name", "version", "orchestrator", "nodes"],
  "properties": {
    "id": { "type": "string" },
    "kind": { "const": "team" },
    "name": { "type": "string" },
    "version": { "type": "string" },
    "orchestrator": { "type": "string" },
    "members": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "expert"],
        "properties": {
          "id": { "type": "string" },
          "expert": { "type": "string" },
          "dependsOn": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "objective": { "type": "string" }
        }
      }
    },
    "execution": {
      "type": "object",
      "properties": {
        "strategy": { "const": "dag" },
        "maxParallel": { "type": "integer", "minimum": 1, "maximum": 6 },
        "failurePolicy": { "enum": ["continue", "abort"] }
      },
      "additionalProperties": false
    }
  }
}
