{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meteomate.local/schemas/weather-source-registry.schema.json",
  "title": "MeteoMate Weather Source Registry",
  "type": "object",
  "required": ["apiVersion", "kind", "sources"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "meteomate.weather/v1" },
    "kind": { "const": "WeatherSourceRegistry" },
    "path": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["id", "type"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9]+(?:[._-][A-Za-z0-9]+)*$"
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 512 },
        "description": { "type": "string", "maxLength": 4096 },
        "type": { "enum": ["local", "http-json"] },
        "root": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "baseUrl": {
          "type": "string",
          "pattern": "^https?://"
        },
        "queryPath": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "method": { "enum": ["GET", "POST"] },
        "headers": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
          },
          "additionalProperties": { "type": "string" }
        },
        "credentialRef": {
          "type": "string",
          "pattern": "^weather:[A-Za-z0-9]+(?:[._-][A-Za-z0-9]+)*$"
        },
        "tokenEnv": { "type": "string", "pattern": "^METEOMATE_WEATHER_TOKEN_" },
        "token": { "type": "string", "minLength": 1 },
        "apiKey": { "type": "string", "minLength": 1 },
        "authScheme": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._~-]{0,31}$"
        },
        "allowedHosts": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "allowInsecure": { "type": "boolean" },
        "followRedirects": { "type": "boolean" },
        "maxResponseBytes": { "type": "integer", "minimum": 1 },
        "maxLocalFileBytes": { "type": "integer", "minimum": 1 },
        "timeoutMs": { "type": "integer", "minimum": 1 },
        "version": { "type": "string", "minLength": 1 },
        "classification": {
          "enum": ["demo", "experimental", "beta", "production"]
        },
        "official": { "type": "boolean" },
        "synthetic": { "type": "boolean" },
        "authority": {
          "enum": ["fixture", "workspace", "deployment", "untrusted"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "local" } },
            "required": ["type"]
          },
          "then": {
            "properties": { "root": true },
            "required": ["root"]
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "http-json" } },
            "required": ["type"]
          },
          "then": {
            "properties": { "baseUrl": true },
            "required": ["baseUrl"]
          }
        }
      ]
    }
  }
}
