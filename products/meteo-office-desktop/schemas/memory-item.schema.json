{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meteomate.local/schemas/memory-item.schema.json",
  "title": "MeteoMate Memory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "id",
    "scope",
    "memoryType",
    "title",
    "summary",
    "sourceRefs",
    "authority",
    "confidence",
    "temporal",
    "status",
    "tags",
    "pinned",
    "createdBy",
    "revision",
    "recordHash",
    "createdAt",
    "updatedAt",
    "useCount"
  ],
  "properties": {
    "apiVersion": { "const": "meteomate.ai/v1" },
    "kind": { "const": "Memory" },
    "id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "enum": ["user", "project"] },
        "id": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "memoryType": {
      "enum": [
        "preference",
        "decision",
        "correction",
        "note",
        "task-summary",
        "case-summary",
        "procedure-candidate"
      ]
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 240 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 8000 },
    "structuredData": { "type": "object", "additionalProperties": true },
    "sourceRefs": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "id"],
        "properties": {
          "kind": {
            "enum": ["task", "run", "message", "evidence", "artifact", "signoff", "project", "manual"]
          },
          "id": { "type": "string", "minLength": 1, "maxLength": 240 },
          "hash": { "type": ["string", "null"], "maxLength": 160 },
          "title": { "type": ["string", "null"], "maxLength": 240 },
          "excerpt": { "type": ["string", "null"], "maxLength": 1200 }
        }
      }
    },
    "authority": {
      "enum": ["user-confirmed", "signed-publication", "verified-tool", "model-extracted"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "temporal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "validFrom", "validTo", "expiresAt"],
      "properties": {
        "class": { "enum": ["stable", "operational", "event"] },
        "validFrom": { "type": ["integer", "null"] },
        "validTo": { "type": ["integer", "null"] },
        "expiresAt": { "type": ["integer", "null"] }
      }
    },
    "status": { "enum": ["active", "archived", "superseded", "rejected"] },
    "supersedes": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "maxLength": 200 },
      "uniqueItems": true
    },
    "tags": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "maxLength": 80 },
      "uniqueItems": true
    },
    "pinned": { "type": "boolean" },
    "createdBy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "enum": ["user", "system", "model"] },
        "id": { "type": ["string", "null"], "maxLength": 200 }
      }
    },
    "extractorVersion": { "type": "string", "maxLength": 120 },
    "revision": { "type": "integer", "minimum": 1 },
    "recordHash": { "type": "string", "minLength": 16 },
    "createdAt": { "type": "integer" },
    "updatedAt": { "type": "integer" },
    "lastUsedAt": { "type": ["integer", "null"] },
    "useCount": { "type": "integer", "minimum": 0 }
  }
}
