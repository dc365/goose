{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meteomate.local/schemas/skill-draft.schema.json",
  "title": "MeteoMate Skill Draft",
  "type": "object",
  "required": ["apiVersion", "kind", "id", "displayName", "skillId", "status", "createdAt", "updatedAt"],
  "properties": {
    "apiVersion": {"const": "meteomate.ai/v1"},
    "kind": {"const": "SkillDraft"},
    "id": {"type": "string", "pattern": "^draft-[A-Za-z0-9-]{8,80}$"},
    "displayName": {"type": "string", "minLength": 1},
    "skillId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version": {"type": "string"},
    "status": {"enum": ["drafting", "ready", "installed", "archived"]},
    "brief": {"type": "object"},
    "projectId": {"type": ["string", "null"]},
    "lastValidation": {"type": ["object", "null"]},
    "installationId": {"type": ["string", "null"]},
    "createdAt": {"type": "number"},
    "updatedAt": {"type": "number"},
    "installedAt": {"type": ["number", "null"]},
    "exportedAt": {"type": ["number", "null"]}
  }
}
