{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meteomate.local/schemas/task.schema.json",
  "title": "MeteoMate Task",
  "type": "object",
  "required": ["id", "title", "lifecycleState", "workMode"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string" },
    "kind": { "enum": ["task", "assistant", "automation", "workflow"] },
    "lifecycleState": {
      "enum": ["DRAFT", "PLANNING", "WAITING_INPUT", "WAITING_APPROVAL", "RUNNING", "PARTIAL", "COMPLETED", "FAILED", "CANCELLED", "ARCHIVED"]
    },
    "workMode": { "enum": ["ask", "plan", "execute"] },
    "projectId": { "type": ["string", "null"] },
    "expertId": { "type": ["string", "null"] },
    "expertSnapshot": { "$ref": "expert.schema.json" },
    "workflowId": { "type": ["string", "null"] },
    "workflowVersion": { "type": ["string", "null"] },
    "workflowRunId": { "type": ["string", "null"] },
    "workflowIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "teamDefinition": { "type": ["object", "null"] },
    "teamRun": {
      "type": ["object", "null"],
      "properties": {
        "id": { "type": "string" },
        "teamId": { "type": "string" },
        "responseId": { "type": ["string", "null"] },
        "status": { "enum": ["running", "synthesizing", "completed", "partial", "failed", "cancelled", "interrupted"] },
        "phase": { "enum": ["dispatching", "executing", "members", "synthesizing", "completed", "failed", "cancelled", "interrupted"] },
        "members": { "type": "array", "items": { "type": "object" } },
        "timeline": {
          "type": "array",
          "maxItems": 60,
          "items": {
            "type": "object",
            "required": ["id", "type", "title", "status", "at"],
            "properties": {
              "id": { "type": "string" },
              "key": { "type": "string" },
              "type": { "enum": ["status", "dispatch", "member", "progress", "activity", "handoff", "synthesis", "completion", "error"] },
              "memberId": { "type": ["string", "null"] },
              "actor": { "type": "string" },
              "title": { "type": "string" },
              "detail": { "type": "string" },
              "status": { "type": "string" },
              "at": { "type": "number" }
            }
          }
        }
      }
    },
    "teamRuns": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "object" }
    },
    "capabilityMode": { "enum": ["inherit", "custom"] },
    "connectorIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "toolSelections": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" },
        "uniqueItems": true
      }
    },
    "sessionCapabilityHash": { "type": ["string", "null"] },
    "capabilityLoad": { "type": ["object", "null"] },
    "contextSnapshotId": { "type": ["string", "null"] },
    "memoryPolicy": {
      "type": "object",
      "properties": {
        "useProjectMemory": { "type": "boolean" },
        "useUserMemory": { "type": "boolean" },
        "learnFromTask": { "type": "boolean" },
        "maxItems": { "type": "integer", "minimum": 1, "maximum": 20 },
        "charBudget": { "type": "integer", "minimum": 1000, "maximum": 24000 }
      }
    },
    "memoryContext": {
      "oneOf": [
        { "$ref": "memory-context-snapshot.schema.json" },
        { "type": "null" }
      ]
    },
    "memoryUsedIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "memoryContextError": { "type": ["string", "null"] },
    "memoryUseError": { "type": ["string", "null"] },
    "runAttempts": { "type": "array", "items": { "type": "object" } },
    "checkpoints": { "type": "array", "items": { "type": "object" } },
    "validationResults": { "type": "array", "items": { "type": "object" } },
    "evidenceIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "artifactIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "expectedOutputs": { "type": "array", "items": { "type": "object" } }
  }
}
