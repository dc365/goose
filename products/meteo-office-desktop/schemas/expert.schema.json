{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meteomate.local/schemas/expert.schema.json",
  "title": "MeteoMate Expert",
  "type": "object",
  "required": ["id", "name", "version", "instruction"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "version": { "type": "string" },
    "instruction": { "type": "string" },
    "mission": { "type": "string" },
    "methodology": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "requiredSkills": { "type": "array", "items": { "type": "string" } },
    "optionalSkills": { "type": "array", "items": { "type": "string" } },
    "requiredConnectors": { "type": "array", "items": { "type": "string" } },
    "defaultWorkMode": { "enum": ["ask", "plan", "execute"] },
    "modelPolicy": { "type": "string" },
    "inputSchema": { "type": ["object", "null"] },
    "outputSchema": { "type": ["object", "null"] }
  }
}
