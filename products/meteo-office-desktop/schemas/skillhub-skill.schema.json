{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meteomate.local/schemas/skillhub-skill.schema.json",
  "title": "MeteoMate SkillHub Skill",
  "type": "object",
  "required": ["id", "name", "publisher", "visibility", "status", "versions"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "name": {"type": "string", "minLength": 1},
    "summary": {"type": "string"},
    "description": {"type": "string"},
    "categories": {"type": "array", "items": {"type": "string"}},
    "tags": {"type": "array", "items": {"type": "string"}},
    "publisher": {"type": "object", "required": ["id", "name"]},
    "visibility": {"enum": ["public", "organization", "private"]},
    "status": {"enum": ["draft", "published", "deprecated"]},
    "latestVersion": {"type": "string"},
    "versions": {"type": "array", "items": {"type": "string"}},
    "featured": {"type": "boolean"},
    "downloads": {"type": "integer", "minimum": 0}
  }
}
