{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meteomate.local/schemas/skillhub-collection.schema.json",
  "title": "MeteoMate SkillHub Collection",
  "type": "object",
  "required": ["id", "name", "skills"],
  "properties": {
    "id": {"type": "string"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "featured": {"type": "boolean"},
    "skills": {
      "type": "array",
      "items": {"type": "object", "required": ["skillId"], "properties": {"skillId": {"type": "string"}, "version": {"type": "string"}}}
    }
  }
}
